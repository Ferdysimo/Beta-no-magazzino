# In dry-run the worker only performs read-only preflight checks.
MEMORY_ENABLED=true
MEMORY_DRY_RUN=true
MEMORY_WRITE_ENABLED=false

SOURCE_MONGO_URL=mongodb://memory_source_user:CHANGE_ME@127.0.0.1:27017/?authSource=pastasciutta
SOURCE_DB_NAME=pastasciutta
MEMORY_MONGO_URL=mongodb://memory_store_user:CHANGE_ME@127.0.0.1:27017/?authSource=pastasciutta_memory
MEMORY_DB_NAME=pastasciutta_memory

# Set only when moving from dry-run to active collection.
MEMORY_ACTIVATION_EPOCH_UTC=

MEMORY_POLL_SECONDS=60
MEMORY_BATCH_SIZE=50
MEMORY_OVERLAP_SECONDS=300
MEMORY_MONGO_TIMEOUT_MS=2500
MEMORY_ALLOW_UNVERIFIED_MONGO_ROLES=false

MEMORY_MAX_SOURCE_LATENCY_MS=500
MEMORY_MAX_STORAGE_MB=1024
MEMORY_CIRCUIT_BREAKER_FAILURES=5
MEMORY_MAX_BACKOFF_SECONDS=900
MEMORY_SNAPSHOT_INTERVAL_SECONDS=900
